{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1360px"
		},
		"custom": {
			"corner": "48px",
			"corner-small": "16px",
			"header-height": "88px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#F8F7F3"
				},
				{
					"slug": "surface-2",
					"name": "Surface alt",
					"color": "#ECEBE5"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#1F2420"
				},
				{
					"slug": "ink-2",
					"name": "Ink soft",
					"color": "#474D47"
				},
				{
					"slug": "ink-3",
					"name": "Ink faint",
					"color": "#5C625B"
				},
				{
					"slug": "deep",
					"name": "Deep band",
					"color": "#2F3A2E"
				},
				{
					"slug": "on-deep",
					"name": "Text on deep",
					"color": "#F3F3EE"
				},
				{
					"slug": "on-deep-2",
					"name": "Soft text on deep",
					"color": "#CDD3C8"
				},
				{
					"slug": "tint",
					"name": "Sand band",
					"color": "#ECEAE3"
				},
				{
					"slug": "on-tint",
					"name": "Text on sand",
					"color": "#1F2420"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#C7CDBF"
				},
				{
					"slug": "accent-strong",
					"name": "Accent for text",
					"color": "#4E5E46"
				},
				{
					"slug": "line",
					"name": "Line",
					"color": "#E0DED7"
				},
				{
					"slug": "oat",
					"name": "Light band",
					"color": "#F8F7F3"
				},
				{
					"slug": "oat-2",
					"name": "Light band alt",
					"color": "#F8F7F3"
				},
				{
					"slug": "pattern",
					"name": "Pattern line",
					"color": "#C2C8BC"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vh",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "20",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "clamp(1.5rem, 3vw, 2.5rem)"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "clamp(2.5rem, 5vw, 4rem)"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "clamp(5rem, 11vw, 10rem)"
				},
				{
					"slug": "70",
					"name": "XXL",
					"size": "clamp(6rem, 14vw, 12.5rem)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Extra small",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9375rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.375rem",
					"fluid": {
						"min": "1.2rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2rem",
					"fluid": {
						"min": "1.6rem",
						"max": "2.2rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "3.25rem",
					"fluid": {
						"min": "2.1rem",
						"max": "3.25rem"
					}
				},
				{
					"slug": "statement",
					"name": "Statement",
					"size": "2.875rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.875rem"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "5rem",
					"fluid": {
						"min": "2.6rem",
						"max": "5rem"
					}
				}
			],
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Hanken Grotesk",
					"fontFamily": "\"Hanken Grotesk\", system-ui, -apple-system, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Hanken Grotesk",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/hanken-grotesk-wght.woff2"
							]
						}
					]
				},
				{
					"slug": "serif",
					"name": "Newsreader",
					"fontFamily": "\"Newsreader\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Newsreader",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/pairings/newsreader-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/pairings/newsreader-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "italic",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/pairings/newsreader-latin-wght-italic.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "italic",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/pairings/newsreader-latin-ext-wght-italic.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|surface",
			"text": "var:preset|color|ink"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|serif",
					"fontWeight": "300",
					"lineHeight": "1.08",
					"letterSpacing": "-0.012em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|display",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.02"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "350",
					"letterSpacing": "-0.005em"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "400",
					"letterSpacing": "0"
				}
			},
			"link": {
				"color": {
					"text": "currentColor"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|ink",
					"text": "var:preset|color|surface"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500",
					"letterSpacing": "0.01em"
				},
				"spacing": {
					"padding": {
						"top": "0.85em",
						"bottom": "0.85em",
						"left": "1.6em",
						"right": "1.6em"
					}
				},
				"border": {
					"radius": "0 0 var(--wp--custom--corner-small) 0"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|ink"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|accent",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				},
				"color": {
					"text": "var:preset|color|ink-3"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontSize": "1.625rem",
					"fontWeight": "500",
					"letterSpacing": "-0.02em"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/quote": {
				"border": {
					"width": "0"
				},
				"typography": {
					"fontSize": "var:preset|font-size|statement",
					"fontWeight": "300",
					"lineHeight": "1.22",
					"letterSpacing": "-0.02em"
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|line"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "announcement",
			"title": "Announcement bar",
			"area": "uncategorized"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "header-panel",
			"title": "Header — menu panel, over the hero",
			"area": "header"
		},
		{
			"name": "header-panel-solid",
			"title": "Header — menu panel",
			"area": "header"
		},
		{
			"name": "menu-panel",
			"title": "Menu panel",
			"area": "uncategorized"
		},
		{
			"name": "sidebar",
			"title": "Sidebar (journal and articles)",
			"area": "uncategorized"
		}
	],
	"customTemplates": [
		{
			"name": "page-journal",
			"title": "Journal (latest stories)",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-journal-sidebar",
			"title": "Journal with sidebar",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "single-sidebar",
			"title": "Article with sidebar",
			"postTypes": [
				"post"
			]
		}
	]
}
